# VoiceMode settings. Only overrides live here; VoiceMode defaults cover the rest.

# Voice blend (weights in parentheses) and speaking speed
VOICEMODE_VOICES=bf_emma(2)+af_bella(1)+af_heart(1)
VOICEMODE_TTS_SPEED=1.2

VOICEMODE_WHISPER_LANGUAGE=en
VOICEMODE_WHISPER_MODEL=large-v2

VOICEMODE_PRONOUNCE="
TTS \bJSON\b jason # JSON as jason
TTS \bYAML\b yammel # YAML as yammel
TTS \bAPI\b A P I # API as individual letters
"
